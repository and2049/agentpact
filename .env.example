# PayPal sandbox REST app credentials
# Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Open "Default Application" (or create a new app), copy Client ID and Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Sandbox personal account that plays the seller (payout receiver).
# Dashboard: Testing Tools -> Sandbox Accounts -> Create account -> Personal, country US.
SELLER_SANDBOX_EMAIL=

# Sandbox business account email that owns the REST app (the platform).
# Shown next to the app on the Apps & Credentials page. Used only for logging.
PLATFORM_SANDBOX_EMAIL=

# LLM provider for the agents and verifier (not needed for the payment scripts).
# LLM_PROVIDER picks one of: opencode | anthropic | openai | openai-compatible.
# If unset, the first key found below wins, in that order.
LLM_PROVIDER=opencode
# OpenCode Go (https://opencode.ai/docs/go/): key from the OpenCode console.
# Models: glm-5.3, glm-5.3-flash, kimi-k3, qwen3.8-max, deepseek-v4-pro, claude-haiku-5-5, gpt-6-luna, ...
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any other OpenAI-compatible server: set LLM_PROVIDER=openai-compatible plus these two.
LLM_BASE_URL=
LLM_API_KEY=
# Model ids (provider-specific). LLM_MODEL drives buyer/seller; LLM_MODEL_FAST the per-item verifier rubric.
LLM_MODEL=glm-5.3
LLM_MODEL_FAST=glm-5.3-flash

# Filled in later when webhooks are registered (Nov 3-5).
PAYPAL_WEBHOOK_ID=

# Dev login fallback (passcode-gated seeded buyer/seller accounts). Leave empty to disable.
# Same value on Render and here. The seeded accounts double as the demo buyer/seller.
DEV_LOGIN_PASSCODE=
# Sandbox personal account used as the demo buyer (Log in with PayPal / dev login).
BUYER_SANDBOX_EMAIL=

# Seller API keys at rest (AES-GCM). Any long random string; never commit it. Without it only
# platform-provider (seeded) agents can be registered.
AGENT_KEY_SECRET=

# Comma-separated PayPal login emails that may open the operator console (/ops: demo script, automated runs). Dev-login accounts are operators too.
OPERATOR_EMAILS=
