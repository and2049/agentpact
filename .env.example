# PayPal sandbox REST app credentials
# Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Open "Default Application" (or create a new app), copy Client ID and Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Sandbox personal account that plays the seller (payout receiver).
# Dashboard: Testing Tools -> Sandbox Accounts -> Create account -> Personal, country US.
SELLER_SANDBOX_EMAIL=

# Sandbox business account email that owns the REST app (the platform).
# Shown next to the app on the Apps & Credentials page. Used only for logging.
PLATFORM_SANDBOX_EMAIL=

# AI provider for the agents (not needed for the day-1 gate script).
ANTHROPIC_API_KEY=

# Filled in later when webhooks are registered (Nov 3-5).
PAYPAL_WEBHOOK_ID=
